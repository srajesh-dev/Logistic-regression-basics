import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression


data = pd.DataFrame({
    'hours_studied': [1, 2, 3, 4, 5, 6, 7, 8],
    'pass_exam':     [0, 0, 0, 1, 1, 1, 1, 1]
})

X = data[['hours_studied']]
y = data['pass_exam']

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=123)

# Step 3: Train logistic regression
model = LogisticRegression()
model.fit(X_train, y_train)

print("I can predict if u will pass or fail based on how many hours you studied using Logistic Regression!")
time_studied = int(input("Enter how many hours u studied: "))
pass_or_fail = model.predict([[time_studied]])
if pass_or_fail == 1:
    print("You Pass!")
else:
    print("""
